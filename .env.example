# Copy to .env and fill in. .env is git-ignored.

# Admins, named in advance (comma-separated). An admin can always sign up,
# and can invite everyone else on /admin/invites. Sign-up is invite-only.
ADMIN_EMAILS=admin@gmail.com

# Signs the session cookie. Required in production; use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
